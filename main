import os
import sys
import time
import random
import getpass
import ctypes
import tkinter as tk
from tkinter import messagebox
import pygame
from PIL import ImageGrab

def resource_path(relative_path):
    try:
        base_path = sys._MEIPASS
    except Exception:
        base_path = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(base_path, relative_path)
USERNAME = getpass.getuser()
#1. СТАРТОВОЕ ОКНО WINDOWS
def show_warning_dialog():
    root = tk.Tk()
    root.withdraw() 
    
    response = messagebox.askyesno(
        "Критическое предупреждение",
        "Ты точно уверен в своих намерениях? Я не отвечаю за исправность твоей системы потом" 
    )
    root.destroy()
    return response

if not show_warning_dialog():
    sys.exit()

#2. ЗАХВАТ РАБОЧЕГО СТОЛА
screenshot = ImageGrab.grab()
screenshot.save("fake_desktop.png")
import ctypes
import os

def set_max_volume():
    VK_VOLUME_UP = 0xAF
    for _ in range(50):
        ctypes.windll.user32.keybd_event(VK_VOLUME_UP, 0, 0, 0)
        ctypes.windll.user32.keybd_event(VK_VOLUME_UP, 0, 2, 0)

def create_desktop_file(filename, content):
    desktop = os.path.join(os.environ['USERPROFILE'], 'Desktop')
    filepath = os.path.join(desktop, filename)
    
    try:
        with open(filepath, 'w', encoding='utf-8') as f:
            f.write(content)
    except Exception as e:
        print(f"Не удалось создать файл: {e}")

#3. ИНИЦИАЛИЗАЦИЯ PYGAME
pygame.init()
screen_info = pygame.display.Info()
WIDTH, HEIGHT = screen_info.current_w, screen_info.current_h
screen = pygame.display.set_mode((WIDTH, HEIGHT), pygame.FULLSCREEN)
pygame.display.set_caption("System.exe")

# Настройки цветов
BLACK = (0, 0, 0)
CHRONOS_GREEN = (0, 255, 0)      
LIGHT_GREEN = (150, 255, 150)    
TEXT_BLACK = (0, 0, 0)           

font_large = pygame.font.SysFont("courier", 40, bold=True)
font_small = pygame.font.SysFont("courier", 30, bold=True)
font_main = font_large

#ИНИЦИАЛИЗАЦИЯ ЗВУКА
pygame.mixer.init()

def play_sound(filename):
    path = resource_path(filename) 
    if os.path.exists(path):
        sound = pygame.mixer.Sound(path)
        sound.play()
    else:
        print(f"Звук {filename} не найден!")
def show_chronos_image():
    logo_path = resource_path("chronos_logo.png")
    if os.path.exists(logo_path):
        img = pygame.image.load(logo_path).convert_alpha()
        img_rect = img.get_rect(center=(WIDTH // 2, HEIGHT // 2))
        screen.fill(BLACK)
        screen.blit(img, img_rect)
        pygame.display.flip()
        pygame.time.wait(3000) 
    else:
        print(f"Логотип не найден: {logo_path}")

negative_points = 0 

#4. ЭФФЕКТЫ ГЛЮКОВ
def glitch_desktop():
    try:
        bg = pygame.image.load("fake_desktop.png").convert()
    except:
        bg = pygame.Surface((WIDTH, HEIGHT))
        bg.fill((50, 50, 50))
    
    bg = pygame.transform.scale(bg, (WIDTH, HEIGHT))
    
    for i in range(40):
        pygame.event.pump()
        screen.blit(bg, (0, 0))
        for _ in range(10):
            y1 = random.randint(0, HEIGHT)
            h = random.randint(10, 100)
            shift_x = random.randint(-50, 50)
            strip = bg.subsurface((0, y1, WIDTH, min(h, HEIGHT - y1)))
            screen.blit(strip, (shift_x, y1))
        
        dark_surface = pygame.Surface((WIDTH, HEIGHT))
        dark_surface.set_alpha(i * 6)
        dark_surface.fill(BLACK)
        screen.blit(dark_surface, (0, 0))
        
        pygame.display.flip()
        pygame.time.wait(50)
        
    screen.fill(BLACK)
    pygame.display.flip()
    pygame.time.wait(1000)
    
    if os.path.exists("fake_desktop.png"):
        os.remove("fake_desktop.png")
        
def add_mild_noise():
    x = random.randint(0, WIDTH - 200)
    y = random.randint(0, HEIGHT - 50)
    w = random.randint(50, 300)
    h = random.randint(10, 40)
    
    rect = pygame.Rect(x, y, w, h)
    try:
        chunk = screen.subsurface(rect).copy()
        screen.blit(chunk, (x + random.randint(-15, 15), y + random.randint(-5, 5)))
    except ValueError:
        pass 

#5. ОТРИСОВКА И ПЕЧАТНАЯ МАШИНКА
def type_text(lines, start_y):
    y_offset = start_y
    completed_lines = [] 
    
    for line in lines:
        displayed_text = ""
        for char in line:
            pygame.event.pump()
            displayed_text += char
            
            screen.fill(BLACK)
            
            prev_y = start_y
            for comp_line in completed_lines:
                txt_surf = font_main.render(comp_line, True, CHRONOS_GREEN)
                screen.blit(txt_surf, (50, prev_y))
                prev_y += 40
                
            txt_surface = font_main.render(displayed_text, True, CHRONOS_GREEN)
            screen.blit(txt_surface, (50, y_offset))
            
            pygame.display.flip()
            pygame.time.wait(20)
            
        completed_lines.append(line)
        y_offset += 40
    return y_offset

def play_background_music(filename):
    music_path = resource_path(filename)
    if os.path.exists(music_path):
        pygame.mixer.music.load(music_path)
        pygame.mixer.music.play(-1) 
        pygame.mixer.music.set_volume(0.4) 
    else:
        print(f"Фоновый файл {filename} не найден!")
        
def draw_buttons(choices, start_y):
    mouse_pos = pygame.mouse.get_pos()
    buttons = []
    y_offset = start_y + 50
    
    for choice in choices:
        text_surf = font_small.render(choice["text"], True, TEXT_BLACK)
        text_rect = text_surf.get_rect()
        
        # Размеры кнопки
        btn_width = text_rect.width + 40
        btn_height = text_rect.height + 20
        btn_rect = pygame.Rect(50, y_offset, btn_width, btn_height)
        
        # Эффект свечения при наведении
        if btn_rect.collidepoint(mouse_pos):
            pygame.draw.rect(screen, LIGHT_GREEN, btn_rect, border_radius=2)
        else:
            pygame.draw.rect(screen, CHRONOS_GREEN, btn_rect, border_radius=2) # Обычный ярко-зеленый фон
            
        # Центрируем
        screen.blit(text_surf, (btn_rect.x + 20, btn_rect.y + 10))
        
        buttons.append({"rect": btn_rect, "next": choice["next"], "neg_mod": choice.get("neg_mod", 0)})
        y_offset += btn_height + 20 
        
    pygame.display.flip()
    return buttons

