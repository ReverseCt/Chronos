#7. ГЛАВНЫЙ ИГРОВОЙ ЦИКЛ
def main_game():
    global negative_points
    
    # 1.первичное окно
    screen.fill(BLACK)
    pygame.display.flip()
    pygame.event.pump()
    
    # 2.запуск музык и глитч
    play_background_music("ambient_hum.mp3") 
    
    if 'glitch_desktop' in globals():
        glitch_desktop()
        
    current_node = "intro"
    
    running = True
    while running:
        node_data = dialogue_tree[current_node]
        
        # 1.
        if "condition_neg_points" in node_data:
            if negative_points >= node_data["condition_neg_points"]:
                current_node = node_data["next_if_true"]
            else:
                current_node = node_data["next_if_false"]
            continue
            
        # 2.
        if node_data.get("action_volume_100"):
            set_max_volume()
            
        if node_data.get("action_sound"):
            play_sound(node_data["action_sound"])
            
        if node_data.get("action_create_file"):
            file_info = node_data["action_create_file"]
            create_desktop_file(file_info["name"], file_info["content"])
            
        if node_data.get("action_random_files"):
            for i in range(10):
                create_desktop_file(f"SYS_ERR_{random.randint(1000, 9999)}.txt", "Ты мне не подходишь, НЕ СМЕЙ МЕШАТЬ МОИМ ПЛАНАМ")

        # 3. Полная печать текста Хроноса
        current_y = type_text(node_data["text"], 50)
        
        # Функция для защиты текста при сворачивании окна
        def redraw_static_text():
            y_offset = 50
            for line in node_data["text"]:
                txt_surface = font_main.render(line, True, CHRONOS_GREEN)
                screen.blit(txt_surface, (50, y_offset))
                y_offset += 40

        # 4. Проверка на конец программы
        if node_data.get("end_program"):
            if node_data.get("action_glitch"):
                glitch_desktop()
            if node_data.get("action_show_logo"):
                show_chronos_image()
            if node_data.get("action_tk_message"):
                root = tk.Tk()
                root.withdraw()
                messagebox.showinfo("Системное уведомление", node_data["action_tk_message"])
                root.destroy()
            running = False
            break

        # 5. Ожидание выбора игрока
        waiting_for_input = True
        last_glitch = pygame.time.get_ticks()
        choices_start_time = pygame.time.get_ticks() 
        last_hovered_index = -1 
        
        while waiting_for_input and running:
            pygame.event.pump() # Главная защита от «Не отвечает»
            
            screen.fill(BLACK)
            redraw_static_text()
            
            elapsed_time = pygame.time.get_ticks() - choices_start_time
            visible_count = min(len(node_data["choices"]), (elapsed_time // 300) + 1)
            current_choices = node_data["choices"][:visible_count]
            
            buttons = draw_buttons(current_choices, current_y)
            
            if pygame.time.get_ticks() - last_glitch > random.randint(200, 800):
                add_mild_noise()
                last_glitch = pygame.time.get_ticks()

            mouse_pos = pygame.mouse.get_pos()
            current_hovered = -1
            for idx, btn in enumerate(buttons):
                if btn["rect"].collidepoint(mouse_pos):
                    current_hovered = idx
                    break
            
            if current_hovered != -1 and current_hovered != last_hovered_index:
                play_sound("hover_sound.mp3") 
            last_hovered_index = current_hovered

            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    play_sound("error_sound1.mp3") 
                    continue
                    
                if event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F4 and (pygame.key.get_mods() & pygame.KMOD_ALT):
                        play_sound("error_sound1.mp3") 
                        continue
                    
                if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    for btn in buttons:
                        if btn["rect"].collidepoint(mouse_pos):
                            negative_points += btn["neg_mod"]
                            current_node = btn["next"]
                            
                            if current_node not in dialogue_tree:
                                print(f"ОШИБКА: Узел {current_node} не найден!")
                                running = False
                                
                            waiting_for_input = False
                            break
                            
            pygame.display.flip()

    pygame.quit()
    sys.exit()

if __name__ == "__main__":
    main_game()
